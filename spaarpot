#!/usr/bin/env python3
"""Spaar-app server: statische bestanden + API voor accounts en gegevens."""
import json, os, hashlib, secrets, threading, re
from http.server import ThreadingHTTPServer, SimpleHTTPRequestHandler

BASE = os.path.dirname(os.path.abspath(__file__))
DATA_DIR = os.path.join(BASE, "data")
DB_FILE = os.path.join(DATA_DIR, "users.json")
LOCK = threading.Lock()


def load_db():
    if not os.path.exists(DB_FILE):
        return {}
    try:
        with open(DB_FILE, "r", encoding="utf-8") as f:
            return json.load(f)
    except Exception:
        return {}


def save_db(db):
    os.makedirs(DATA_DIR, exist_ok=True)
    tmp = DB_FILE + ".tmp"
    with open(tmp, "w", encoding="utf-8") as f:
        json.dump(db, f, ensure_ascii=False)
    os.replace(tmp, DB_FILE)


def hash_pw(salt, pw):
    return hashlib.sha256((salt + pw).encode("utf-8")).hexdigest()


def normalize_id(raw):
    raw = (raw or "").strip().lower()
    if "@" in raw:
        if re.match(r"^[^@\s]+@[^@\s]+\.[^@\s]+$", raw):
            return "email:" + raw
        return None
    digits = re.sub(r"[^\d+]", "", raw)
    digits_only = re.sub(r"\D", "", digits)
    if len(digits_only) >= 8:
        return "tel:" + digits_only
    return None


class Handler(SimpleHTTPRequestHandler):
    def __init__(self, *args, **kwargs):
        super().__init__(*args, directory=BASE, **kwargs)

    def log_message(self, *args):
        pass

    # ---- helpers ----
    def send_json(self, obj, code=200):
        body = json.dumps(obj, ensure_ascii=False).encode("utf-8")
        self.send_response(code)
        self.send_header("Content-Type", "application/json; charset=utf-8")
        self.send_header("Content-Length", str(len(body)))
        self.send_header("Cache-Control", "no-store")
        self.end_headers()
        self.wfile.write(body)

    def read_body(self):
        try:
            length = int(self.headers.get("Content-Length", 0))
            if length <= 0 or length > 2_000_000:
                return None
            return json.loads(self.rfile.read(length).decode("utf-8"))
        except Exception:
            return None

    def auth_user(self, db):
        auth = self.headers.get("Authorization", "")
        if not auth.startswith("Bearer "):
            return None
        token = auth[7:].strip()
        if not token:
            return None
        for uid, u in db.items():
            if u.get("token") == token:
                return uid
        return None

    # ---- routes ----
    def do_POST(self):
        if self.path == "/api/register":
            body = self.read_body() or {}
            uid = normalize_id(body.get("id", ""))
            pw = body.get("password", "")
            if not uid:
                return self.send_json({"error": "Geef een geldig e-mailadres of gsm-nummer op."}, 400)
            if len(pw) < 4:
                return self.send_json({"error": "Kies een wachtwoord van minstens 4 tekens."}, 400)
            with LOCK:
                db = load_db()
                if uid in db:
                    return self.send_json({"error": "Dit account bestaat al. Log in met je wachtwoord."}, 409)
                salt = secrets.token_hex(16)
                token = secrets.token_hex(24)
                db[uid] = {
                    "salt": salt,
                    "pw": hash_pw(salt, pw),
                    "token": token,
                    "data": None,
                }
                save_db(db)
            return self.send_json({"token": token, "user": uid, "data": None})

        if self.path == "/api/login":
            body = self.read_body() or {}
            uid = normalize_id(body.get("id", ""))
            pw = body.get("password", "")
            if not uid:
                return self.send_json({"error": "Geef een geldig e-mailadres of gsm-nummer op."}, 400)
            with LOCK:
                db = load_db()
                u = db.get(uid)
                if not u or hash_pw(u["salt"], pw) != u["pw"]:
                    return self.send_json({"error": "Onbekend account of fout wachtwoord."}, 401)
                u["token"] = secrets.token_hex(24)
                save_db(db)
                return self.send_json({"token": u["token"], "user": uid, "data": u.get("data")})

        if self.path == "/api/data":
            body = self.read_body()
            with LOCK:
                db = load_db()
                uid = self.auth_user(db)
                if not uid:
                    return self.send_json({"error": "Niet ingelogd."}, 401)
                db[uid]["data"] = body
                save_db(db)
            return self.send_json({"ok": True})

        return self.send_json({"error": "Onbekende route."}, 404)

    def do_GET(self):
        if self.path == "/api/data":
            with LOCK:
                db = load_db()
                uid = self.auth_user(db)
                if not uid:
                    return self.send_json({"error": "Niet ingelogd."}, 401)
                return self.send_json({"data": db[uid].get("data"), "user": uid})
        return super().do_GET()


